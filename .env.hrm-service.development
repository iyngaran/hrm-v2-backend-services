# HRM Service Environment Variables
# Copy this to .env.development when running HRM service

# ====================
# Common Configuration
# ====================
NODE_ENV=development

# Pino Logger Configuration
LOGGER_ENABLE=true
LOGGER_CONSOLE_TARGET_ENABLE=true
LOGGER_FILE_TARGET_ENABLE=true
LOGGER_DEFAULT_LEVEL=info
LOGGER_CONSOLE_LEVEL=info
LOGGER_FILE_LEVEL=info

# ====================
# HRM Service Configuration
# ====================
GRPC_HRM_SERVICE_URL=0.0.0.0:50003

# HRM Service Database
HRM_SERVICE_DB_HOST=localhost
HRM_SERVICE_DB_PORT=5432
HRM_SERVICE_DB_USER=iyngaran
HRM_SERVICE_DB_PASSWORD=
HRM_SERVICE_DB_NAME=hrm_hrm_service_db
HRM_SERVICE_DB_SYNCHRONIZE=true
HRM_SERVICE_DB_LOGGING=false

# ====================
# Other Configuration
# ====================
SOME_ENV_VARIABLE=default_value
