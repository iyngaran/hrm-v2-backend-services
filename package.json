{
  "name": "hrm-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "//": "=== GIT HOOKS & AUTOMATION ===",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/apps/api-gateway/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:user-service:e2e": "jest --config ./apps/user-service/test/jest-e2e.json",
    "test:user-service:e2e:clean": "./scripts/test-e2e-user-service.sh",
    "test:api-gateway:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "test:hrm-service:e2e": "jest --config ./apps/hrm-service/test/jest-e2e.json",
    "quality:check": "pnpm lint:check && pnpm format:check && pnpm type:check",
    "quality:fix": "pnpm lint:fix && pnpm format:write",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint:check": "test -d apps -o -d libs && eslint \"{apps,libs}/**/*.ts\" || echo 'Skipping lint:check - no apps/libs directories found'",
    "lint:fix": "test -d apps -o -d libs && eslint \"{apps,libs}/**/*.ts\" --fix || echo 'Skipping lint:fix - no apps/libs directories found'",
    "format:check": "test -d apps -o -d libs && prettier --check \"{apps,libs}/**/*.{ts,json}\" || echo 'Skipping format:check - no apps/libs directories found'",
    "format:write": "prettier --write \"{apps,libs}/**/*.{ts,json}\" || echo 'Skipping format:write - no apps/libs directories found'",
    "type:check": "test -d apps -o -d libs && tsc --noEmit || echo 'Skipping type:check - no apps/libs directories found'",
    "proto:validate": "./scripts/proto-manager.sh validate",
    "proto:types": "./scripts/proto-manager.sh typescript",
    "proto:grpc": "./scripts/proto-manager.sh grpc",
    "proto:build": "./scripts/proto-manager.sh build",
    "proto:clean": "./scripts/proto-manager.sh clean",
    "proto:list": "./scripts/proto-manager.sh list",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm quality:check && pnpm test --passWithNoTests",
    "lint-staged-fix": "eslint --fix"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "camelcase-keys": "^9.1.3",
    "chalk": "^5.4.1",
    "long": "^5.3.2",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-proto": "^2.7.5",
    "typeorm": "^0.3.25",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/chalk": "^2.2.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "grpc-tools": "^1.12.4",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/"
    ],
    "moduleNameMapper": {
      "^@app/libs(|/.*)$": "<rootDir>/libs/src/$1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm exec eslint --fix --config eslint-staged.config.mjs"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
