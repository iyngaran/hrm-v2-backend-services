# API Gateway Environment Variables
# Copy this to .env.development when running API Gateway

# ====================
# Common Configuration
# ====================
NODE_ENV=development

# Pino Logger Configuration
LOGGER_ENABLE=true
LOGGER_CONSOLE_TARGET_ENABLE=true
LOGGER_FILE_TARGET_ENABLE=true
LOGGER_DEFAULT_LEVEL=info
LOGGER_CONSOLE_LEVEL=info
LOGGER_FILE_LEVEL=info

# ====================
# API Gateway Configuration
# ====================
API_GATEWAY_PORT=3000
# GRPC URLs for services that the API Gateway communicates with
GRPC_USER_SERVICE_URL=0.0.0.0:50002
GRPC_HRM_SERVICE_URL=0.0.0.0:50003

# ====================
# Other Configuration
# ====================
SOME_ENV_VARIABLE=default_value

# Note: API Gateway doesn't need database configuration
