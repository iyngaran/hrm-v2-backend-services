# User Service Environment Variables
# Copy this to .env.development when running user service

# ====================
# Common Configuration
# ====================
NODE_ENV=development

# Pino Logger Configuration
LOGGER_ENABLE=true
LOGGER_CONSOLE_TARGET_ENABLE=true
LOGGER_FILE_TARGET_ENABLE=true
LOGGER_DEFAULT_LEVEL=info
LOGGER_CONSOLE_LEVEL=info
LOGGER_FILE_LEVEL=info

# ====================
# User Service Configuration
# ====================
GRPC_USER_SERVICE_URL=0.0.0.0:50002

# User Service Database
USER_SERVICE_DB_HOST=localhost
USER_SERVICE_DB_PORT=5432
USER_SERVICE_DB_USER=iyngaran
USER_SERVICE_DB_PASSWORD=
USER_SERVICE_DB_NAME=hrm_user_service_db
USER_SERVICE_DB_SYNCHRONIZE=true
USER_SERVICE_DB_LOGGING=false
# ====================
# Other Configuration
# ====================
SOME_ENV_VARIABLE=default_value
